{
  "name": "uconnect",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@reduxjs/toolkit": "^2.2.3",
    "@supabase/supabase-js": "^2.46.1",
    "expo": "~54.0.27",
    "expo-constants": "~18.0.10",
    "expo-dev-client": "~6.0.20",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.9",
    "expo-linking": "~8.0.10",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "~0.32.14",
    "expo-router": "~6.0.17",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "^54.0.7",
    "typescript": "~5.9.2"
  },
  "expo": {
    "scheme": "uconnect",
    "android": {
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "uconnect",
              "host": "*"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow UConnect to save photos.",
          "savephotosPermission": "Allow UConnect to save photos to your library."
        }
      ]
    ]
  }
}
